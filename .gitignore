# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Coverage / test artifacts
coverage
playwright-report
test-results
.vitest-cache

# Python (services/classifier)
__pycache__/
*.pyc
.venv
venv
*.egg-info

# Prisma
prisma/*.db
prisma/dev.db*

# Demo seed's raw session token for scripts/capture-evidence.ts — a dev-only cookie value for a
# synthetic account, never a real credential, but not something to commit either.
scripts/.demo-session-tokens.json

# Logs
logs
*.log

# Editor / OS
.DS_Store
.fleet
.idea
.vscode/*
!.vscode/extensions.json

# Local env files — never commit real secrets
.env
.env.*
!.env.example

# Docs screenshots are optional evidence; keep the folder's README but ignore images by default
docs/screenshots/*
!docs/screenshots/README.md

# Participant data must never be committed, accidentally or otherwise (rule R10)
*.csv
data/
