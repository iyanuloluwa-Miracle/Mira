// Prisma schema — the single source of truth for persisted shapes.
// See docs/data-model.md for the narrative version (including the Mermaid ERD) and
// docs/ndpa-mapping.md for how retention and data-subject rights map onto this schema.
//
// Encryption boundary: free text and clinician notes are encrypted application-side with
// AES-256-GCM before they ever reach a query (rule R5) — the ciphertext/iv/authTag columns
// below only ever hold opaque bytes. Emails are stored as keyed hashes, never plaintext.
// Item-level answer validity (0-3) is enforced in server/domain/scoring.ts, not by a DB
// constraint — see that file once it lands.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------------------

enum AuthMode {
  REGISTERED
  ANONYMOUS
}

// [FR6][NFR1] HUMAN_REVIEW gates whether an escalate-worthy result becomes an identifiable
// Escalation row a clinician can see — see server/domain/consent.ts. Distinct from SCREENING
// (using the app at all) and RESEARCH_LOGGING (storing a conversation transcript): a person can
// use every other part of Mira, including seeing their own escalation-worthy result and the
// referral information and helplines, without ever granting this one.
enum ConsentPurpose {
  SCREENING
  RESEARCH_LOGGING
  HUMAN_REVIEW
}

enum Instrument {
  PHQ9
  GAD7
  COMBINED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RiskLevel {
  MINIMAL
  MILD
  MODERATE
  HIGH
  CRISIS
}

enum EscalationStatus {
  PENDING
  ACKNOWLEDGED
  CONTACTED
  CLOSED
}

enum ClinicianRole {
  CLINICIAN
  ADMIN
}

// --- Core models ---------------------------------------------------------------------------

// [FR1] A person using the app. Anonymous use is first-class (rule R9): authMode defaults to
// ANONYMOUS and every other field that could identify a person is nullable until/unless they
// register.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  pseudonym       String    @unique
  authMode        AuthMode  @default(ANONYMOUS)
  emailHash       String?   @unique
  // The email itself, encrypted (rule R5) so it can be decrypted server-side for delivery
  // (e.g. a password-reset or notification email) without ever being queryable in plaintext.
  // emailHash above is what login/registration actually look up by.
  emailCiphertext Bytes?
  emailIv         Bytes?
  emailAuthTag    Bytes?
  passwordHash    String?
  ageBand         String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  deletedAt       DateTime?

  consentRecords    ConsentRecord[]
  screeningSessions ScreeningSession[]
  sessions          Session[]

  @@map("users")
}

// [FR1] A server-side session record backing an httpOnly session cookie. Only tokenHash is
// stored — the raw token lives in the cookie and is never persisted — so a database read alone
// can never be used to forge or hijack a session. expiresAt implements sliding expiry: it's
// pushed forward (and the cookie re-issued) on activity by server/middleware/auth.ts, up to
// SESSION_TTL_MS from the most recent request.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// [NFR1] One row per consent decision. granted/withdrawnAt lets a purpose's consent state be
// reconstructed at any point in time rather than overwritten in place.
model ConsentRecord {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  consentVersion String
  purpose        ConsentPurpose
  granted        Boolean
  grantedAt      DateTime
  withdrawnAt    DateTime?
  ipHash         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_records")
}

// [FR2] One PHQ-9/GAD-7 administration. Owns the item responses, any optional free-text
// entry, classifier predictions, and — on completion — exactly one TriageResult.
model ScreeningSession {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  instrument      Instrument
  status          SessionStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  clientLatencyMs Int?
  serverLatencyMs Int?
  // [FR3] Set when the person explicitly declines the optional free-text step (server/api/
  // screening/[id]/text.post.ts's skip path) — distinct from simply never having called that
  // endpoint, so the result page can say "you chose not to share a written response" rather
  // than silently showing nothing.
  freeTextExcluded Boolean       @default(false)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemResponses     ItemResponse[]
  freeTextEntries   FreeTextEntry[]
  modelPredictions  ModelPrediction[]
  triageResult      TriageResult?
  conversationTurns ConversationTurn[]

  @@index([userId])
  @@map("screening_sessions")
}

// [FR2] One answered item. Unique on (sessionId, itemCode) so an answer submission is
// idempotent — a retried request on a poor connection upserts rather than duplicating.
model ItemResponse {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  itemCode   String
  rawValue   Int
  answeredAt DateTime @default(now())

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, itemCode])
  @@index([sessionId])
  @@map("item_responses")
}

// [FR3][R5] Optional free-text answer, encrypted application-side before it reaches this
// table. Never holds plaintext — see server/utils/crypto.ts once it lands.
model FreeTextEntry {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  charCount  Int
  createdAt  DateTime @default(now())

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("free_text_entries")
}

// [FR3][R1] One classifier call's output. Supplementary signal only — see
// server/domain/triage.ts once it lands for how (and how little) this can move a risk band.
model ModelPrediction {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @db.Uuid
  modelName      String
  modelVersion   String
  probability    Float
  predictedLabel String
  latencyMs      Int
  topTokensJson  Json
  createdAt      DateTime @default(now())

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("model_predictions")
}

// [R6][NFR1] One request/response turn in the bounded conversational layer (component 4).
// Metadata is always stored; the transcript itself only when RESEARCH_LOGGING consent was
// active at the moment this turn was written (checked in server/api/conversation/, not here —
// this schema has no opinion, it just has nullable transcript columns). preFilterTriggered
// true means the LLM was never called for this turn at all (server/domain/conversation-safety.ts).
model ConversationTurn {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @db.Uuid
  turnNumber           Int
  modelName            String
  modelVersion         String
  latencyMs            Int
  promptTokens         Int
  completionTokens     Int
  preFilterTriggered   Boolean  @default(false)
  preFilterReason      String?
  postFilterTriggered  Boolean  @default(false)
  postFilterReason     String?
  // [R5] Present only with active RESEARCH_LOGGING consent — encrypted the same way as
  // FreeTextEntry. Absent otherwise, not even as an empty placeholder.
  transcriptCiphertext Bytes?
  transcriptIv         Bytes?
  transcriptAuthTag    Bytes?
  createdAt            DateTime @default(now())

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("conversation_turns")
}

// [FR4][R1][NFR5] The one deterministic triage outcome for a session. rationaleJson holds
// the plain-language reasons (see server/domain/triage.ts); riskLevel is never set or
// overridden by a model — only ever raised by at most one step, which the rationale records.
model TriageResult {
  id            String    @id @default(uuid()) @db.Uuid
  sessionId     String    @unique @db.Uuid
  phq9Total     Int
  gad7Total     Int
  phq9Band      String
  gad7Band      String
  riskLevel     RiskLevel
  rationaleJson Json
  escalated     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  session         ScreeningSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recommendations ResourceRecommendation[]
  escalation      Escalation?

  @@index([riskLevel])
  @@map("triage_results")
}

// [FR5] A psychoeducational resource. isActive is the deactivation mechanism — resources are
// never hard-deleted once recommended, so historical ResourceRecommendation rows stay valid.
// body holds the raw markdown authored in content/resources/*.md, ingested by prisma/seed.ts —
// rendering to HTML happens per-request in server/api/resources/[slug].get.ts, not at seed time.
model Resource {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String
  slug               String    @unique
  body               String
  language           String    @default("en")
  tags               String[]
  minRisk            RiskLevel
  maxRisk            RiskLevel
  readingTimeMinutes Int
  // [R10] A citable reference for this article's content, or a TODO_VERIFY placeholder — never
  // fabricated. See server/plugins/warn-unverified-resource-sources.ts.
  sourceAttribution  String
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  recommendations ResourceRecommendation[]

  @@map("resources")
}

// [FR5] Ranked link between a triage result and a recommended resource.
model ResourceRecommendation {
  id             String @id @default(uuid()) @db.Uuid
  triageResultId String @db.Uuid
  resourceId     String @db.Uuid
  rank           Int

  triageResult TriageResult @relation(fields: [triageResultId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([triageResultId, resourceId])
  @@index([triageResultId])
  @@index([resourceId])
  @@map("resource_recommendations")
}

// [FR6][FR7][NFR1] Human-support follow-up for one triage result. Only ever created when
// HUMAN_REVIEW consent is active at the moment of creation (server/domain/consent.ts) — an
// escalate-worthy result with no such consent gets a referral screen and helplines client-side
// but never a row here (see server/api/screening/[id]/complete.post.ts and
// server/api/screening/[id]/escalate.post.ts, the two places a row can be created). Once
// created, a row is never deleted for a later consent withdrawal — the case history is a fact
// about what happened, not a live mirror of current consent — but notesCiphertext's sibling
// free-text field on the same detail view re-checks live consent on every read (rule R4/NFR1).
// clinicianId is nullable and set to null (not cascaded away) if a clinician account is later
// removed, so the case history survives staff turnover.
model Escalation {
  id              String           @id @default(uuid()) @db.Uuid
  triageResultId  String           @unique @db.Uuid
  status          EscalationStatus @default(PENDING)
  clinicianId     String?          @db.Uuid
  acknowledgedAt  DateTime?
  notesCiphertext Bytes?
  notesIv         Bytes?
  notesAuthTag    Bytes?
  createdAt       DateTime         @default(now())

  triageResult TriageResult @relation(fields: [triageResultId], references: [id], onDelete: Cascade)
  clinician    Clinician?   @relation(fields: [clinicianId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clinicianId])
  @@map("escalations")
}

// [FR7] A clinician/admin account. Deliberately separate from User — the clinician auth realm
// and the person-being-screened auth realm never share a table, a session type, or a login
// page (see CONTRIBUTING.md and ClinicianSession below, the clinician-realm counterpart to
// Session). Unlike User.emailHash, Clinician.email is stored in the clear: clinicians are
// staff, not the vulnerable population NFR1's protections are built around, and they need to
// be contactable by that address.
model Clinician {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  fullName     String
  role         ClinicianRole @default(CLINICIAN)
  isActive     Boolean       @default(true)

  escalations       Escalation[]
  clinicianSessions ClinicianSession[]

  @@map("clinicians")
}

// [FR7] A server-side session record backing the clinician-realm httpOnly session cookie —
// the exact same shape and sliding-expiry discipline as Session (server/middleware/auth.ts),
// but a distinct table and a distinct cookie name (server/utils/clinician-auth.ts) so a
// clinician session and a person-being-screened session can never be confused for one another,
// including by two different pieces of middleware reading two different cookies.
model ClinicianSession {
  id          String   @id @default(uuid()) @db.Uuid
  clinicianId String   @db.Uuid
  tokenHash   String   @unique
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime

  clinician Clinician @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  @@index([clinicianId])
  @@map("clinician_sessions")
}

// [R4][NFR1] Append-only audit trail. metadataJson must never carry PHI or free text — the
// same discipline as the request logger (server/utils/logger.ts), enforced by convention and
// by code review here since there is no relation to redact through.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorType    String
  actorId      String
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@map("audit_logs")
}

// --- Evaluation instrumentation (Chapter Four evidence) -----------------------------------

// [NFR3] One latency observation. name distinguishes the operation (e.g.
// "screening_complete_server_ms", "classifier_call_e2e_ms" — see
// docs/evaluation-data-dictionary.md for the full, exact list and what each one measures).
// sessionId is deliberately not a foreign key: this table is read in bulk, long after an
// individual ScreeningSession may already be gone (a person can delete a session immediately,
// rule R9; free text and abandoned sessions are deleted on a schedule, NFR1) — a latency
// observation outliving the session it was measured on is the point, not a bug, the same
// reasoning AuditLog above already applies to actorId.
model Metric {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  valueMs   Int
  sessionId String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@map("metrics")
}

// [Chapter Four, Section 3.8.3] One moderated-usability-test sitting. Identified only by a
// participant code the researcher enters at session start (never linked to User — this is a
// study record, not an account) and only ever created once informed consent has already been
// given: consentedAt is required, not optional, so "evaluation logging is off unless the flag
// is set AND the participant has consented" is an enforced fact about this row, not a trusted
// external process. See server/api/admin/evaluation/start.post.ts.
model EvaluationSession {
  id              String    @id @default(uuid()) @db.Uuid
  participantCode String
  consentedAt     DateTime
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  events EvaluationEvent[]

  @@index([participantCode])
  @@map("evaluation_sessions")
}

// [Chapter Four, Section 3.8.3] Every event type Section 3.8.3 needs for task-completion rate
// and median time on task. No content field exists on this model anywhere below, by design —
// see EvaluationEvent's own comment.
enum EvaluationEventType {
  TASK_START
  TASK_END
  SCREEN_TRANSITION
  BACK_NAVIGATION
  ERROR_ENCOUNTERED
  ABANDONMENT
}

// [Chapter Four, Section 3.8.3] taskId/screen are short, researcher-defined or route-derived
// labels (e.g. "task-1-complete-screening", "/screen/[id]") — never user input, never free
// text. completed is only meaningful on a TASK_END row. There is deliberately no field here
// that could ever hold what a participant typed or said — this table answers "what happened
// and when," never "what was written."
model EvaluationEvent {
  id                  String              @id @default(uuid()) @db.Uuid
  evaluationSessionId String              @db.Uuid
  type                EvaluationEventType
  taskId              String?
  screen              String?
  completed           Boolean?
  createdAt           DateTime            @default(now())

  evaluationSession EvaluationSession @relation(fields: [evaluationSessionId], references: [id], onDelete: Cascade)

  @@index([evaluationSessionId])
  @@map("evaluation_events")
}
