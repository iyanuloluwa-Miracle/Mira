# Copy this file to .env and fill in real values locally. Never commit .env.
# See CLAUDE.md rule R10: no real secrets or real helpline numbers pending verification
# ever enter this repository, including in commit history.

# --- Database (prisma/schema.prisma) ---------------------------------------
# Postgres connection string used by Prisma. This default matches docker-compose.yml's db
# service. No Docker? Run `npm run db:local` instead and use the URL it prints (needs
# ?pgbouncer=true — see scripts/dev-db.ts).
DATABASE_URL="postgresql://mira:mira@localhost:5432/mira?schema=public"

# --- Encryption (server/utils/crypto.ts, rule R5) ---------------------------
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of free text and
# clinician notes at rest. The app must refuse to boot without this set.
# Generate locally with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Identifier hashing (server/utils/privacy.ts, NFR1) ---------------------
# Pepper used when hashing identifiers (email, IP) to keyed HMAC-SHA256 hashes instead of
# storing them in plaintext. Distinct secret from ENCRYPTION_KEY above — never reuse it.
# Generate locally with: openssl rand -base64 32
IDENTIFIER_HASH_PEPPER=""


# --- Auth (server/api/auth/, FR1) -------------------------------------------
# Secret used to sign session tokens.
AUTH_SECRET=""

# --- NLP classifier (server/services/classifier/, component 3) -------------
# "mock" (default) uses a deterministic local signal, no network call — safe for a fresh
# clone, tests, and demos. "http" calls CLASSIFIER_SERVICE_URL below. Either way, screening
# must still complete if the classifier is unavailable (rule R7).
CLASSIFIER_MODE="mock"

# Base URL of the classifier inference service. Points at services/classifier/ locally
# (see docker-compose.yml). Only used when CLASSIFIER_MODE="http".
CLASSIFIER_SERVICE_URL="http://localhost:8001"

# Request timeout in milliseconds before one classifier attempt is treated as failed.
CLASSIFIER_TIMEOUT_MS="3000"

# --- Conversational layer LLM (server/services/conversation/, component 4) -
# Provider API key for the LLM used in the bounded conversational layer. If unset, the
# conversational layer must degrade rather than fail (rule R7).
LLM_API_KEY=""
LLM_MODEL="claude-sonnet-5"

# --- Notifications (server/services/notification/, FR6) --------------------
# Delivery target for escalation notifications to human support/clinicians.
NOTIFICATION_WEBHOOK_URL=""

# --- Runtime (config/runtime.ts) --------------------------------------------
# "development" | "test" | "production"
NODE_ENV="development"

# Public base URL the app is served from, used for building absolute links.
APP_BASE_URL="http://localhost:3000"
